{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Signal Module (Release)",
      "type": "dart",
      "request": "launch",
      "program": "lib/main.dart",
      "cwd": "${workspaceFolder}/signal_module"
    },
    {
      "name": "Signal Module (Debug)",
      "type": "dart",
      "request": "launch",
      "program": "lib/main.dart",
      "cwd": "${workspaceFolder}/signal_module",
      "args": ["--debug"]
    },
    {
      "name": "Signal Module (Profile)",
      "type": "dart",
      "request": "launch",
      "program": "lib/main.dart",
      "cwd": "${workspaceFolder}/signal_module",
      "flutterMode": "profile"
    },
    {
      "name": "Signal Module (Attach)",
      "type": "dart",
      "request": "attach",
      "program": "lib/main.dart"
    }
  ]
}
