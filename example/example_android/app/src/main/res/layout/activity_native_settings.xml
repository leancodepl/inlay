<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Storage-backed native settings"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="Display name" />

        <TextView
            android:id="@+id/valueDisplayName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="-" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Email" />

        <TextView
            android:id="@+id/valueEmail"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="-" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Dark mode" />

        <TextView
            android:id="@+id/valueDarkMode"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="-" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Theme" />

        <TextView
            android:id="@+id/valueTheme"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="-" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Tags" />

        <TextView
            android:id="@+id/valueTags"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="-" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Notification preferences" />

        <TextView
            android:id="@+id/valueNotifPrefs"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="-" />

        <Button
            android:id="@+id/btnSetDemoValues"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Set demo values" />

        <Button
            android:id="@+id/btnToggleDarkMode"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Toggle dark mode" />

        <Button
            android:id="@+id/btnThemeSystem"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Theme: system" />

        <Button
            android:id="@+id/btnThemeLight"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Theme: light" />

        <Button
            android:id="@+id/btnThemeDark"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Theme: dark" />

        <Button
            android:id="@+id/btnAddTag"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Add 'android' tag" />

        <Button
            android:id="@+id/btnSetNotifPrefs"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Set notification prefs" />

        <Button
            android:id="@+id/btnClearNotifPrefs"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Clear notification prefs" />

        <Button
            android:id="@+id/btnFlutterThemeSystem"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Flutter theme: system" />

        <Button
            android:id="@+id/btnFlutterThemeDark"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Flutter theme: dark" />

        <Button
            android:id="@+id/btnFlutterLangPolish"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Flutter language: polski" />

        <Button
            android:id="@+id/btnFlutterLangSystem"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Flutter language: system" />

        <Button
            android:id="@+id/btnOpenFlutterProfile"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Open Flutter Profile" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Framework"
            android:textStyle="bold" />

        <androidx.appcompat.widget.SwitchCompat
            android:id="@+id/switchPrewarm"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Engine prewarming" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Routing entrypoint" />

        <TextView
            android:id="@+id/valueRouting"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="-" />

        <Button
            android:id="@+id/btnRoutingGoRouter"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Routing: go_router" />

        <Button
            android:id="@+id/btnRoutingAutoRoute"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Routing: auto_route" />

        <Button
            android:id="@+id/btnRoutingImperative"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Routing: imperative" />
    </LinearLayout>
</ScrollView>
